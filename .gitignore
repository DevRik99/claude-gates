node_modules/
coverage/

# Local dev DB / state (never commit mutable state)
*.db
*.db-shm
*.db-wal
forge-mcp.db*

# Per-project task state written at runtime (not source)
.ai/tasks/

# Tool map is written at runtime by the tool-map gate and records absolute, machine-specific
# paths — it is per-machine dev state, not source.
.ai/tool-map.json

# Decision log appended by the gates at runtime (and its rotation), plus the capability map
# they persist: per-machine session state, not source.
.ai/gates-log.jsonl
.ai/gates-log.*.jsonl
.ai/capability-map.json

# Keep .ai/config.json (the repo's own gate config for developing the gates) tracked.
# It disables the gates that false-positive when editing the gates themselves, so the
# repo builds the same way on any machine. Everything else under .ai/ that is runtime
# state is ignored above.

# Worker residue, not source
.ai/features/
GATES.md

# Mutation testing reports (generated)
reports/mutation/
.stryker-tmp/
