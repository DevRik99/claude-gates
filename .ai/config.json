      "testPathPattern": "(?:\\.(?:test|spec)\\.[cm]?[jt]sx?|(?:^|[\\\\/])tests?\\.[cm]?[jt]sx?)$",
      "escapeHatch": "adversarial-tests:allow"
    }
  }
}